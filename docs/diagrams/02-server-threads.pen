          "x": 40,
          "y": 655,
          "name": "fault",
          "fill": "#475569",
          "textGrowth": "fixed-width",
          "width": 1020,
          "content": "Fault tolerance: signal(SIGPIPE, SIG_IGN) · recv() = 0 or error only ends that thread · invalid message → ERR without closing · invalid datagram → dropped and logged · reads and sends have an absolute deadline, so a slow client cannot hold a thread indefinitely",
          "lineHeight": 1.5,
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "normal"
        },
