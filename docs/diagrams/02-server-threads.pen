            {
              "type": "text",
              "id": "jyWjT",
              "name": "sub l2",
              "fill": "#9D174D",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The producer only enqueues; the thread that owns the connection is the only one that sends.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 10,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "hcqkG",
              "name": "sub l3",
              "fill": "#9D174D",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Queue full → shutdown() of the slow subscriber, so UDP ingestion is never blocked.",
              "lineHeight": 1.4,
              "fontFamily": "Inter",
              "fontSize": 10,
              "fontWeight": "normal"
            }
          ]
        },
